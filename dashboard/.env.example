# Which API this dashboard talks to. Baked in at build time — restart the dev
# server, or redeploy, after changing it.
#
# The deployed API allows a localhost origin on purpose (its CORS_ORIGIN lists
# localhost:5173 and localhost:3001), so you can run this against production
# data locally by using the second line instead.

VITE_API_URL=http://localhost:3000/api
# VITE_API_URL=https://hajar-pakistan-api-sf1r.vercel.app/api
