# --- Database ---
# Production (Render/Railway/etc): use the SRV form Atlas gives you.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hajar?retryWrites=true&w=majority
#
# Local dev: if Node cannot resolve SRV records (querySrv ECONNREFUSED — some
# Windows/VPN setups leave c-ares without a resolver), use the direct form
# listing the shard hosts instead. Atlas: Connect > Drivers > "connection
# string for older drivers".
# MONGODB_URI=mongodb://USER:PASSWORD@shard-00-00.xxx.mongodb.net:27017,shard-00-01.xxx.mongodb.net:27017,shard-00-02.xxx.mongodb.net:27017/hajar?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# --- Seeded admin (dashboard sign-in) ---
ADMIN_EMAIL=admin@hajar.pk
ADMIN_PASSWORD="change-me-use-quotes-if-special-chars"

# --- Cloudinary (optional: product image + video uploads) ---
# Leave unset and the API still boots; the /uploads endpoint returns 503 and
# the Instagram importer hot-links the original image instead of mirroring it.
# Fill all three in to switch uploading on.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Boot seeding ---
# Upserts the admin user and default collections on every startup. Leave true
# on a long-running server; set false on Vercel, where it would re-run on each
# cold start — seed from your machine with reset:admin / sync:collections.
SEED_ON_BOOT=true

# --- CORS ---
# Comma separated, no spaces. Keep the localhost entries even in production:
# they are what lets you run the dashboard or storefront on your machine
# against the deployed API. Note localhost and 127.0.0.1 are different
# origins to a browser — it sends whatever is in the address bar — so both
# forms are listed.
CORS_ORIGIN=https://hajar.pk,https://www.hajar.pk,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001,http://127.0.0.1:5173
